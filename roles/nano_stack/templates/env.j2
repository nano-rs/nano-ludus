# nano SIEM environment — generated by the Ludus nanosiem_stack role.
# Consumed by docker-compose.yml (${...} interpolation).

# Public URL analysts hit (nginx reverse proxy). Drives CORS + cookie scope.
BASE_URL={{ nanosiem_base_url }}

# Plain-HTTP labs need dev mode so the auth refresh cookie is set without the
# Secure flag (browsers drop Secure cookies over http://).
NANOSIEM_DEV_MODE={{ nanosiem_dev_mode | string | lower }}

# --- Database ---
POSTGRES_USER={{ nanosiem_postgres_user }}
POSTGRES_DB={{ nanosiem_postgres_db }}
POSTGRES_PASSWORD={{ nanosiem_postgres_password }}
CLICKHOUSE_PASSWORD={{ nanosiem_clickhouse_password }}
CLICKHOUSE_ADMIN_PASSWORD={{ nanosiem_clickhouse_admin_password }}

# --- Secrets ---
JWT_SECRET={{ nanosiem_jwt_secret }}
NANOSIEM_ENCRYPTION_KEY={{ nanosiem_encryption_key }}
VECTOR_AUTH_TOKEN={{ nanosiem_vector_auth_token }}

# --- Retention / tier ---
HOT_RETENTION_DAYS={{ nanosiem_hot_retention_days }}
WARM_RETENTION_DAYS={{ nanosiem_warm_retention_days }}
NANO_TIER={{ nanosiem_tier }}

RUST_LOG=info
GRAFANA_PASSWORD={{ nanosiem_grafana_password }}
{% if nanosiem_cf_ai_gateway_url %}

# --- Cloudflare AI Gateway (meloD) ---
CLOUDFLARE_AI_GATEWAY_URL={{ nanosiem_cf_ai_gateway_url }}
CF_AIG_AUTH_TOKEN={{ nanosiem_cf_aig_auth_token }}
{% endif %}
