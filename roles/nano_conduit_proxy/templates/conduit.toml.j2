# Conduit MITM Proxy Configuration (Ludus Lab)
# Based on upstream conduit.toml — adjusted for Docker networking

# Proxy listener address
listen_addr = "0.0.0.0:8888"

# Management API address
api_addr = "0.0.0.0:8443"

# Dragonfly (Redis-compatible) — Docker service name
dragonfly_url = "redis://conduit-dragonfly:6379"

# CA certificate and key paths (auto-generated if absent, stored in Dragonfly)
# ca_cert_path = "/etc/conduit/ca.pem"
# ca_key_path = "/etc/conduit/ca-key.pem"

# Maximum number of cached per-domain TLS certificates
cert_cache_size = 10000

# Log channel buffer size (proxy never blocks on logging)
log_channel_size = 10000

# Redis connection pool size
redis_pool_size = 16

# Whether unauthenticated traffic should be rejected (407) or allowed with IP logging
auth_required = {{ conduit_auth_required | lower }}

# Maximum number of log entries retained in Dragonfly
log_retention = 100000

# Number of worker threads (default: number of CPUs)
# workers = 4

# Syslog target (optional): udp://host:514 or tcp://host:514
# syslog_target = "udp://syslog.example.com:514"

# TLS interception (MITM) — decrypt CONNECT tunnels to inspect full URLs
tls_intercept = {{ conduit_tls_intercept | lower }}

# Block requests when policy rules cannot be loaded (Redis down, no cache).
fail_closed = {{ conduit_fail_closed | lower }}

# --- HTTP Response Cache ---
[cache]
enabled = {{ conduit_cache_enabled | lower }}
max_cache_size = {{ conduit_cache_max_size_mb * 1048576 }}
max_file_size = 10485760        # 10MB max per response
lock_timeout_secs = 5
stale_while_revalidate_secs = 60
stale_if_error_secs = 300

# --- Threat Detection ---
[threat]
enabled = true

# Tier 0: heuristics (runs on every request, <5us)
tier0_escalation_threshold = 0.3
tier0_block_threshold = 0.9
dga_entropy_threshold = 3.5

# Tier 1: ML decision tree (runs on ~2-5% of requests that T0 flags)
tier1_enabled = true
tier1_escalation_threshold = 0.5

# Tier 2: content inspection (runs on ~0.5%)
tier2_enabled = true
tier2_escalation_threshold = 0.6
max_inspect_bytes = 262144         # 256KB
tier2_block_on_inspect = true

# Tier 3: LLM verdict — OFF for lab
tier3_enabled = false

# Reputation: learns per-domain trust over time
reputation_enabled = true
reputation_decay_hours = 168       # 1 week half-life
reputation_block_threshold = 0.55

# Bloom filter for threat feeds
bloom_capacity = 2000000
bloom_fp_rate = 0.0001
feed_refresh_interval_secs = 3600

# --- Timeout Hardening ---
[timeouts]
connect_timeout_secs = 10
total_connection_timeout_secs = 15
read_timeout_secs = 60
write_timeout_secs = 60
idle_timeout_secs = 300
request_timeout_secs = 0

# --- Request Size Limits ---
[request_limits]
max_request_header_size = 8192
max_request_body_size = 10485760

# --- Graceful Shutdown ---
[shutdown]
grace_period_secs = 60
graceful_shutdown_timeout_secs = 300
upgrade_sock = "/tmp/conduit-upgrade.sock"

# --- Connection Limits ---
[connection_limits]
enabled = true
max_connections_per_ip = 256

# --- DNS Cache ---
[dns]
enabled = true
max_entries = 10000
min_ttl_secs = 30
max_ttl_secs = 3600
negative_ttl_secs = 30

# --- Prometheus Metrics ---
[metrics]
enabled = true
listen_addr = "0.0.0.0:9091"

# --- DLP ---
[dlp]
enabled = true
max_scan_size = 1048576
action = "block"

# --- HTTP/2 Downstream ---
[downstream]
h2c = true
