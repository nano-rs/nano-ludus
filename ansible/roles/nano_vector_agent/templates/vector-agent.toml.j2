# Vector Agent Configuration - Windows Event Log Collection
# Deployed by Ludus Ansible Role on {{ ansible_hostname }}
# Ships to aggregator at {{ vector_aggregator_ip }}:{{ vector_aggregator_port }}

data_dir = "C:/ProgramData/Vector/data"

# =============================================================================
# Source: Windows Event Log (native API via EvtSubscribe)
# =============================================================================
[sources.windows_events]
type = "windows_event_log"
channels = {{ vector_eventlog_channels | to_json }}
read_existing_events = {{ vector_read_existing_events | lower }}
events_per_second = {{ vector_events_per_second }}
max_event_data_length = {{ vector_max_event_data_length }}

# =============================================================================
# Transform: Enrich with host metadata
# =============================================================================
[transforms.enrich_host]
type = "remap"
inputs = ["windows_events"]
source = '''
# Determine source_type — Sysmon gets its own, everything else is windows_event
channel = downcase(to_string(.channel) ?? "")
source_type = "windows_event"
if contains(channel, "sysmon") {
    source_type = "windows_sysmon"
}

# Flatten the entire structured event into a single JSON message
# This matches how all other sources work — parser sees JSON in .message
event_json = encode_json(.)

# Replace the event with just source_type + JSON message
. = {}
.message = event_json
.source_type = source_type
.src_host = "{{ ansible_hostname }}"
'''

# =============================================================================
# Sink: Ship to aggregator via Vector protocol
# =============================================================================
[sinks.aggregator]
type = "vector"
inputs = ["enrich_host"]
address = "{{ vector_aggregator_ip }}:{{ vector_aggregator_port }}"
acknowledgements.enabled = true

# Disk buffer - survives agent restarts without losing events.
#
# NAN-2364: when_full defaults to drop_newest, NOT block. `block` on a full
# buffer stops the windows_event_log source itself, so an aggregator that stops
# draining silently freezes collection on every endpoint until a human notices -
# and restarting the agent does not clear it, because a restart preserves the
# backlog rather than draining it. Shedding the newest events keeps the reader's
# checkpoint moving so collection continues while the backlog waits.
[sinks.aggregator.buffer]
type = "disk"
max_size = {{ vector_buffer_max_bytes }}
when_full = "{{ vector_buffer_when_full }}"

# =============================================================================
# Internal metrics (optional - for debugging)
# =============================================================================
[sources.internal_metrics]
type = "internal_metrics"
scrape_interval_secs = 30
namespace = "vector_agent"

[sinks.internal_console]
type = "console"
inputs = ["internal_metrics"]
encoding.codec = "json"
