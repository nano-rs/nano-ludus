version: '3.8'

# Vector Aggregator - Receives from Windows agents, forwards to SIEM
# Deployed by Ludus Ansible Role

services:
  vector-aggregator:
    image: timberio/vector:latest-alpine
    container_name: vector-aggregator
    security_opt:
      - no-new-privileges:true
    environment:
      VECTOR_DATA_DIR: /var/lib/vector
    ports:
      # Vector protocol - agents connect here
      - "{{ aggregator_vector_port }}:{{ aggregator_vector_port }}"
      # Prometheus metrics
      - "9598:9598"
      # Vector API
      - "8686:8686"
    volumes:
      - ./config/vector.toml:/etc/vector/vector.toml:ro
      - ./healthcheck.sh:/usr/local/bin/nano-healthcheck.sh:ro
      - vector-aggregator-data:/var/lib/vector
    command: ["--config", "/etc/vector/vector.toml"]
    # NAN-2364: the old check was `wget --spider` against the Prometheus
    # exporter - a HEAD request it never answers, so this container reported
    # (unhealthy) permanently and the flag became noise. The script checks the
    # Vector API and sink buffer utilization instead.
    healthcheck:
      test: ["CMD", "/usr/local/bin/nano-healthcheck.sh"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 20s
    restart: unless-stopped

volumes:
  vector-aggregator-data:
